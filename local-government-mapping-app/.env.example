# GeoHub login is the workspace gate only.
PORTAL_URL=https://gh.space.gov.rw/portal
PUBLIC_ORIGIN=https://localhost:5176
SESSION_SECRET=change-this-in-production

# Central Runtime Config service base URL (no trailing path).
# Fetches: {VITE_RUNTIME_CONFIG_URL}/api/v1/config/local-government-mapping
# Leave unset to use bundled defaults only.
# VITE_RUNTIME_CONFIG_URL=
# Runtime Config backend the dev/preview server proxies /api/v1/config and /api/v1/portal-auth to.
RUNTIME_CONFIG_PROXY_TARGET=https://gh.space.gov.rw
