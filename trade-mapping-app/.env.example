# Frontend-only. Login talks to GeoHub directly.
# No API keys are required in this app.

# REQUIRED for Runtime Config connection (otherwise the app uses bundled defaults only).
# Use this app's own HTTPS origin so Vite can proxy to the HTTP backend (avoids mixed content).
# Trade Mapping fetches: {VITE_RUNTIME_CONFIG_URL}/api/v1/config/trade-mapping
#
# Local (with Vite proxy in vite.config.js → RUNTIME_CONFIG_PROXY_TARGET / localhost:3000):
VITE_RUNTIME_CONFIG_URL=https://localhost:5179/trade-mapping
#
# After changing this value, restart `npm run dev` (Vite env is not reliably hot-reloaded).
#
# Direct HTTP backend (only if the Trade UI itself is also HTTP):
# VITE_RUNTIME_CONFIG_URL=http://localhost:3000
# Runtime Config backend the dev/preview server proxies /api/v1/config and /api/v1/portal-auth to.
RUNTIME_CONFIG_PROXY_TARGET=https://gh.space.gov.rw
