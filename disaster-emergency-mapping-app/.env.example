PORTAL_URL=https://gh.space.gov.rw/portal
PUBLIC_ORIGIN=https://localhost:5180
SESSION_SECRET=change-this-in-production

# From the Portal OAuth app
PORTAL_CLIENT_ID=
PORTAL_CLIENT_SECRET=
PORTAL_TOKEN=

# Central Runtime Config service base URL (no trailing path).
# Fetches:
#   {VITE_RUNTIME_CONFIG_URL}/api/v1/config/disaster-emergency-mapping
#   {VITE_RUNTIME_CONFIG_URL}/api/v1/portal-auth/token
# Optional DEV-only bootstrap for browser proof of proxy embeds.
# Never enable in production. When set to 1, exposes:
#   GET /api/portal/dev-embed?host=ewis&item=<id>&kind=dashboard
# ALLOW_DEV_EMBED_BOOTSTRAP=
# Runtime Config backend the dev/preview server proxies /api/v1/config and /api/v1/portal-auth to.
RUNTIME_CONFIG_PROXY_TARGET=https://gh.space.gov.rw
