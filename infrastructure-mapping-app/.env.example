PUBLIC_ORIGIN=https://localhost:5181
WASAC_ORIGIN=https://gis.wasac.rw

# OAuth app registered on the WASAC portal, with PUBLIC_ORIGIN as a redirect URI
PORTAL_CLIENT_ID=
PORTAL_CLIENT_SECRET=

# Required to unlock private layers/groups. Omit for app-token-only behaviour.
INFRA_USERNAME=publisher
INFRA_PASSWORD=

# Central Runtime Config service base URL (no trailing path).
# Fetches: {VITE_RUNTIME_CONFIG_URL}/api/v1/config/infrastructure-mapping
# Leave unset to use bundled defaults only.
# VITE_RUNTIME_CONFIG_URL=
# Runtime Config backend the dev/preview server proxies /api/v1/config and /api/v1/portal-auth to.
RUNTIME_CONFIG_PROXY_TARGET=https://gh.space.gov.rw
