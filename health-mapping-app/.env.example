PORTAL_URL=https://gh.space.gov.rw/portal
PUBLIC_ORIGIN=https://localhost:5175
SESSION_SECRET=change-this-in-production

# Required for Vaccine Distribution Planning (private MoH Experience Builder).
# Use a MoH Enterprise account that can open the app on gis.rbc.gov.rw.
RBC_ORIGIN=https://gis.rbc.gov.rw
RBC_USERNAME=
RBC_PASSWORD=
# Optional alternatives to username/password:
RBC_TOKEN=
RBC_TOKEN_EXPIRES=
RBC_CLIENT_ID=
RBC_CLIENT_SECRET=

# Central Runtime Config service base URL (no trailing path).
# Fetches: {VITE_RUNTIME_CONFIG_URL}/api/v1/config/health-mapping
# Leave unset to use bundled defaults only.
# VITE_RUNTIME_CONFIG_URL=
# Runtime Config backend the dev/preview server proxies /api/v1/config and /api/v1/portal-auth to.
RUNTIME_CONFIG_PROXY_TARGET=https://gh.space.gov.rw
