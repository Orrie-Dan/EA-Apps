  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-data.mjs && vite build",
    "build:static": "node scripts/check-data.mjs && vite build --mode static",
    "preview": "vite preview",
    "test": "vitest run",
    "check:data": "node scripts/check-data.mjs",
    "start": "node server/index.js",
    "cert": "mkdir -p .certs && openssl req -x509 -newkey rsa:2048 -nodes -days 825 -keyout .certs/dev-key.pem -out .certs/dev-cert.pem -subj \"/CN=localhost\" -addext \"subjectAltName=DNS:localhost,DNS:127.0.0.1,IP:127.0.0.1\"",
    "start:local": "node server/index.js --http-only"
  },
  "keywords": [],
