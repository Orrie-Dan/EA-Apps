# Server-side only. Never prefixed VITE_, so these are never sent to the browser.
PORTAL_URL=https://gh.space.gov.rw/portal
PUBLIC_ORIGIN=https://localhost:4173

# Sign the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=change-this-in-production

# Optional. If RSA has registered this portal as an application on GeoHub, the
# server uses the OAuth password grant; without them it falls back to
# generateToken, which also works.
PORTAL_CLIENT_ID=
PORTAL_CLIENT_SECRET=
# Runtime Config backend the dev/preview server proxies /api/v1/config and /api/v1/portal-auth to.
RUNTIME_CONFIG_PROXY_TARGET=https://gh.space.gov.rw
